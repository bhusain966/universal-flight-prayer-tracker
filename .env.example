# ═══════════════════════════════════════════════════════════════════════════
# Universal Flight Prayer Tracker — Environment Variables
#
# Copy this file to .env and fill in your values before running the app.
#
#   cp .env.example .env
#
# Lines starting with # are comments and are ignored.
# ═══════════════════════════════════════════════════════════════════════════


# ── Database ────────────────────────────────────────────────────────────────
# Full MySQL/TiDB connection string.
# For Docker Compose the host is the service name "db".
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://flightuser:flightpassword@db:3306/flighttracker

# MySQL service credentials (used by docker-compose.yml to initialise the db service)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=flighttracker
MYSQL_USER=flightuser
MYSQL_PASSWORD=flightpassword


# ── Session / Auth ──────────────────────────────────────────────────────────
# A long, random secret used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Manus OAuth settings (only required when using Manus platform authentication).
# Leave blank for standalone / self-hosted deployments.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=


# ── Flight Data APIs ─────────────────────────────────────────────────────────
# AirLabs API key (REQUIRED)
# Sign up at https://airlabs.co — free tier includes 1 000 requests/month.
# Used for: live flight status, schedule, aircraft metadata, airport info.
AIRLABS_API_KEY=your_airlabs_api_key_here

# Flightradar24 (FR24) API key (OPTIONAL but recommended)
# Provides: squawk code, callsign, ICAO hex, ADS-B source, runway, distance.
# Contact FR24 for API access: https://www.flightradar24.com/premium/
FR24_API_KEY=your_fr24_api_key_here


# ── Manus Platform APIs (optional) ──────────────────────────────────────────
# Only required when deploying on the Manus hosting platform.
# Leave blank for self-hosted Docker deployments.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=


# ── Server ───────────────────────────────────────────────────────────────────
# Port the Node.js server listens on inside the container.
# The docker-compose.yml maps this to the host port.
PORT=3000
